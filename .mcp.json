{
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ]
    },
    "postgres-local": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://postgres:postgres@127.0.0.1:54322/postgres"
      ]
    },
    "supabase-primary": {
      "type": "http",
      "url": "https://mcp.supabase.com/mcp?project_ref=vrvtsxexkiiiivlkdxzp"
    },
    "n8n": {
      "type": "http",
      "url": "https://plat.app.n8n.cloud/mcp-server/http"
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/"
    }
  }
}
