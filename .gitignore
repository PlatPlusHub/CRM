# Python
__pycache__/
*.pyc

# OS
.DS_Store
Thumbs.db

# Node / project-local Supabase CLI
node_modules/

# Supabase local CLI state (transient)
supabase/.temp/
supabase/.branches/

# Ad-hoc backups — git is the backup (repository-eos-review §9 retirement)
backup/

# Workstation generated logs & raw command captures (transient — scripts regenerate them).
# The curated workstation (scripts, manifest.md, reports/*.md) IS committed; see WORKSTATION.md.
.workstation/reports/*.txt
.workstation/reports/*.log
.workstation/reports/mcp/
.workstation/reports/tools/*.txt

# Local secrets (MCP tokens etc.) — never commit. .mcp.json itself is committed (no secrets in it).
.env
.env.local

# Machine-local Claude settings + their timestamped backups (personal, not shared).
# The governance-bearing half of settings.json is NOT personal and IS tracked, in
# .claude/awareness.json: .workstation/claude-awareness.ps1 -Apply merges it in (prepare.ps1) and
# -Verify reports it missing (doctor.ps1), so a fresh clone cannot end up holding the awareness
# hook and the protected-file rules without the wiring that activates them.
.claude/settings.local.json
.claude/settings.local.backup-*.json
.claude/settings.json

# Editor/vault state -- local tooling, never part of the repository's truth.
.obsidian/

# Local certification receipt written by `check_agent_continuity.ps1 -Finish` (SPEC-164).
# It records that LOCAL verification actually ran against one working tree at one moment,
# and the completion Gate refuses a Complete transition without a fresh matching one. It is
# an observation about a machine, never repository truth: CI holds no receipt and re-executes
# the certification instead. Committing it would publish a claim nobody can re-derive.
.orvion-local-certification.json
